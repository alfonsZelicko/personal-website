{
  "headers": [
    {
      "source": "/(.*).json",
      "headers": [{ "key": "Access-Control-Allow-Origin", "value": "*" }]
    },
    {
      "source": "/(.*).css",
      "headers": [{ "key": "Access-Control-Allow-Origin", "value": "*" }]
    },
    {
      "source": "/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ],
  "build": {
    "env": {
      "HUGO_VERSION": "0.143.1"
    }
  }
}
