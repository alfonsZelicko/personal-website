{
  "name": "alfons-zelicko-website",
  "private": true,
  "scripts": {
    "start": "hugo server",
    "dev": "start http://localhost:1313 && hugo server  --cleanDestinationDir",
    "dev:no-cache": "start http://localhost:1313 && hugo server --disableFastRender --noHTTPCache --cleanDestinationDir",
    "build": "hugo --minify --gc",
    "format": "prettier --write .",
    "new-note": "hugo new notes/2026-02-26-new-note.md"
  },
  "devDependencies": {
    "open-cli": "^8.0.0",
    "prettier": "^3.7.4",
    "prettier-plugin-go-template": "^0.0.15"
  }
}
